generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PartyRole {
  OWNER
  MANAGER
  ADMIN
  MEMBER
}

enum RaidParticipantStatus {
  PRESENT
  ABSENT
}

enum LootDropStatus {
  RECEIVED
}

enum DistributionMethod {
  WEIGHTED
}

enum LedgerTransactionType {
  SALE_POSTED
  PAYOUT_POSTED
}

enum LedgerTransactionStatus {
  DRAFT
  POSTED
}

enum LedgerAccountType {
  PARTY_CASH
  MEMBER_PAYABLE
}

model User {
  id                      String            @id @default(cuid())
  email                   String?           @unique
  username                String?           @unique
  emailVerified           Boolean           @default(false)
  image                   String?
  displayName             String
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  accounts                Account[]
  sessions                Session[]
  memberships             PartyMembership[]
  createdPartyInvitations PartyInvitation[]
  auditEvents             PartyAuditEvent[]
  telegramReads           TelegramImportRead[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Party {
  id                 String                  @id @default(cuid())
  name               String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  selectedStageId    String?
  stageSelectionRevision Int @default(0)
  selectedStage      ServerStage? @relation(fields: [selectedStageId], references: [id], onDelete: Restrict)
  customItems        Item[]
  customInstances    Instance[]
  customLootPresets  PartyInstanceLootPreset[]
  quickLootItems     PartyQuickLootItem[]
  memberships        PartyMembership[]
  invitations        PartyInvitation[]
  telegramBotConfig  PartyTelegramBotConfig?
  auditEvents        PartyAuditEvent[]
  members            PartyMember[]
  memberProfiles     PartyMemberProfile[]
  compositions       PartyComposition[]
  raids              Raid[]
  saleTransactions   SaleTransaction[]
  saleShares         SaleShare[]
  memberPayments     MemberPayment[]
  paymentAllocations PaymentAllocation[]
  ledgerTransactions LedgerTransaction[]
  ledgerEntries      LedgerEntry[]
  telegramImports    TelegramSaleImport[]
  telegramAliases    TelegramItemAlias[]
  @@index([selectedStageId])
}

model PartyTelegramBotConfig {
  partyId              String   @id
  encryptedToken       String
  initializationVector String
  authenticationTag    String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  botId                String?  @unique
  botUsername          String?
  webhookId            String?  @unique
  webhookSecretHash    String?
  webhookEnabled       Boolean  @default(false)
  chatId               String?
  chatTitle            String?
  senderId             String?
  senderUsername       String?
  discoveries          Json     @default("[]")
  lastReceivedAt       DateTime?
  party                Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)
}

model TelegramSaleImport {
  id             String   @id @default(cuid())
  partyId        String
  chatId         String
  senderId       String
  messageId      String
  updateId       String
  rawText        String
  correctedText  String?
  sourceHash     String
  status         String
  reason         String?
  allocations    Json     @default("[]")
  receivedAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  party          Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  reads          TelegramImportRead[]

  @@unique([partyId, chatId, messageId])
  @@index([partyId, createdAt])
}

model TelegramImportRead {
  importId String
  userId   String
  readAt   DateTime @default(now())
  import   TelegramSaleImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([importId, userId])
}

model TelegramItemAlias {
  id             String @id @default(cuid())
  partyId        String
  itemId         String
  name           String
  normalizedName String
  party          Party @relation(fields: [partyId], references: [id], onDelete: Restrict)
  item           Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([partyId, normalizedName])
}

model PartyAuditEvent {
  id                    String   @id @default(cuid())
  partyId               String
  actorUserId           String?
  actorNameSnapshot     String
  actorUsernameSnapshot String?
  action                String
  entityType            String
  entityId              String?
  summary               String
  createdAt             DateTime @default(now())
  party                 Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  actor                 User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([partyId, createdAt])
  @@index([actorUserId, createdAt])
}

model PartyMembership {
  id        String    @id @default(cuid())
  partyId   String
  userId    String
  role      PartyRole @default(OWNER)
  createdAt DateTime  @default(now())

  party Party @relation(fields: [partyId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([partyId, userId])
  @@index([userId])
}

model PartyInvitation {
  id              String    @id @default(cuid())
  partyId         String
  tokenHash       String    @unique
  createdByUserId String
  role            PartyRole @default(MEMBER)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  party     Party @relation(fields: [partyId], references: [id], onDelete: Restrict)
  createdBy User  @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([partyId, createdAt])
}

model PartyMember {
  id                 String   @id @default(cuid())
  partyId            String
  nickname           String
  normalizedNickname String
  isActive           Boolean  @default(true)
  comment            String?
  distributionWeight Int      @default(1)
  className          String?
  level              Int?
  role               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  party              Party                    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  raidParticipants   RaidParticipant[]
  memberPayments     MemberPayment[]
  saleShares         SaleShare[]
  ledgerEntries      LedgerEntry[]
  compositionMembers PartyCompositionMember[]
  profiles           PartyMemberProfile[]

  @@unique([partyId, normalizedNickname])
  @@unique([partyId, id])
}

model PartyMemberProfile {
  id        String   @id @default(cuid())
  partyId   String
  memberId  String
  name      String
  className String
  subclassSlot Int?
  role      String?
  level     Int?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party              Party                    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  member             PartyMember              @relation(fields: [partyId, memberId], references: [partyId, id], onDelete: Restrict)
  compositionMembers PartyCompositionMember[]
  raidParticipants   RaidParticipant[]

  @@unique([partyId, id])
  @@unique([partyId, memberId, name])
  @@unique([partyId, memberId, subclassSlot])
  @@index([partyId, memberId, isActive])
}

model PartyComposition {
  id          String   @id @default(cuid())
  partyId     String
  name        String
  description String?
  focus       String?
  maxMembers  Int      @default(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  party   Party                    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  members PartyCompositionMember[]
  raids   Raid[]

  @@unique([partyId, id])
  @@unique([partyId, name])
  @@index([partyId, updatedAt])
}

model PartyCompositionMember {
  id            String   @id @default(cuid())
  partyId       String
  compositionId String
  memberId      String
  profileId     String?
  classOverride String?
  slotOrder     Int      @default(0)
  roleOverride  String?
  note          String?
  createdAt     DateTime @default(now())

  composition PartyComposition    @relation(fields: [partyId, compositionId], references: [partyId, id], onDelete: Cascade)
  member      PartyMember         @relation(fields: [partyId, memberId], references: [partyId, id], onDelete: Restrict)
  profile     PartyMemberProfile? @relation(fields: [partyId, profileId], references: [partyId, id], onDelete: Restrict)

  @@unique([partyId, compositionId, memberId])
  @@index([partyId, memberId])
}

model Item {
  telegramAliases TelegramItemAlias[]
  id             String   @id @default(cuid())
  partyId        String?
  isActive       Boolean @default(true)
  party          Party? @relation(fields: [partyId], references: [id], onDelete: Restrict)
  canonicalName  String
  normalizedName String
  displayName    String?
  category       String?
  grade          String?
  itemType       String?
  itemSubtype    String?
  isRare         Boolean  @default(false)
  gameVersion    String?
  comment        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lootDrops LootDrop[]

  stageRecommendations InstanceStageLootRecommendation[]
  customPresetItems PartyInstanceLootPresetItem[]
  quickLootItems PartyQuickLootItem[]
  @@unique([partyId, normalizedName])
  @@unique([partyId, id])
  @@index([partyId, isActive, normalizedName])
  @@index([category])
}

model Raid {
  id             String    @id @default(cuid())
  partyId        String
  name           String
  instanceName   String?
  instanceId     String?
  stageId        String?
  stageCodeSnapshot String?
  stageNameSnapshot String?
  stageRevisionSnapshot Int?
  creationKey    String?
  creationPayloadHash String?
  instance       Instance? @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  stage          ServerStage? @relation(fields: [stageId], references: [id], onDelete: Restrict)
  occurredAt     DateTime
  screenshotPath String?
  comment        String?
  lockedAt       DateTime?
  compositionId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  party            Party             @relation(fields: [partyId], references: [id], onDelete: Restrict)
  composition      PartyComposition? @relation(fields: [partyId, compositionId], references: [partyId, id], onDelete: Restrict)
  participants     RaidParticipant[]
  lootDrops        LootDrop[]
  saleTransactions SaleTransaction[]

  @@unique([partyId, id])
  @@index([partyId, occurredAt])
  @@unique([partyId, creationKey])
  @@index([partyId, instanceId])
  @@index([partyId, stageId, occurredAt])
}

enum InstanceSource {
  H5
  SERVER_VARIANT
  CUSTOM
}

model Instance {
  id String @id @default(cuid())
  code String @unique
  name String
  displayName String
  normalizedName String
  aliases String[]
  category String
  source InstanceSource
  partyId String?
  imagePath String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  party Party? @relation(fields: [partyId], references: [id], onDelete: Restrict)
  raids Raid[]
  recommendations InstanceStageLootRecommendation[]
  customPresets PartyInstanceLootPreset[]
  @@unique([partyId, id])
  @@unique([partyId, normalizedName])
  @@index([partyId, isActive])
}

model ServerStage {
  id String @id @default(cuid())
  code String @unique
  name String
  sequence Int @unique
  isSelectable Boolean @default(false)
  publishedAt DateTime?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parties Party[]
  raids Raid[]
  configurations ServerStageConfig[]
  recommendations InstanceStageLootRecommendation[]
  auditEvents ServerStageAuditEvent[]
}

model ServerStageConfig {
  id String @id
  explicitCurrentStageId String?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  explicitCurrentStage ServerStage? @relation(fields: [explicitCurrentStageId], references: [id], onDelete: Restrict)
}

model InstanceStageLootRecommendation {
  id String @id @default(cuid())
  instanceId String
  stageId String
  itemId String
  sortOrder Int
  sourceMetadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  stage ServerStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)
  @@unique([instanceId, stageId, itemId])
  @@index([stageId, instanceId, sortOrder])
  @@index([itemId])
}

model PartyInstanceLootPreset {
  id String @id @default(cuid())
  partyId String
  instanceId String
  sourceLabel String?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  party Party @relation(fields: [partyId], references: [id], onDelete: Restrict)
  instance Instance @relation(fields: [partyId, instanceId], references: [partyId, id], onDelete: Restrict)
  items PartyInstanceLootPresetItem[]
  @@unique([partyId, instanceId])
  @@unique([partyId, id])
}

model PartyInstanceLootPresetItem {
  id String @id @default(cuid())
  partyId String
  presetId String
  itemId String
  sortOrder Int
  preset PartyInstanceLootPreset @relation(fields: [partyId, presetId], references: [partyId, id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)
  @@unique([presetId, itemId])
  @@index([partyId, presetId, sortOrder])
}

model PartyQuickLootItem {
  partyId String
  itemId String
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  party Party @relation(fields: [partyId], references: [id], onDelete: Restrict)
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)
  @@id([partyId, itemId])
}

model ServerStageAuditEvent {
  id String @id @default(cuid())
  stageId String?
  action String
  actor String
  sourceLabel String?
  idempotencyKey String @unique
  beforeState Json?
  afterState Json?
  createdAt DateTime @default(now())
  stage ServerStage? @relation(fields: [stageId], references: [id], onDelete: Restrict)
  @@index([stageId, createdAt])
}

model RaidParticipant {
  id                 String                @id @default(cuid())
  partyId            String
  raidId             String
  memberId           String
  profileId          String?
  nicknameSnapshot   String
  status             RaidParticipantStatus
  distributionWeight Int
  classSnapshot      String?
  roleSnapshot       String?
  profileSnapshot    String?
  levelSnapshot      Int?
  compositionSlot    Int?
  createdAt          DateTime              @default(now())

  raid       Raid                @relation(fields: [partyId, raidId], references: [partyId, id], onDelete: Restrict)
  member     PartyMember         @relation(fields: [partyId, memberId], references: [partyId, id], onDelete: Restrict)
  profile    PartyMemberProfile? @relation(fields: [partyId, profileId], references: [partyId, id], onDelete: Restrict)
  saleShares SaleShare[]

  @@unique([partyId, raidId, memberId])
  @@unique([partyId, raidId, id, memberId])
  @@index([partyId, memberId])
}

model LootDrop {
  id             String         @id @default(cuid())
  partyId        String
  raidId         String
  itemId         String
  quantity       Int
  screenshotPath String?
  status         LootDropStatus @default(RECEIVED)
  comment        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  raid             Raid              @relation(fields: [partyId, raidId], references: [partyId, id], onDelete: Restrict)
  item             Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  saleTransactions SaleTransaction[]

  @@unique([partyId, id])
  @@unique([partyId, raidId, id])
  @@index([partyId, raidId, createdAt])
  @@index([partyId, itemId, createdAt])
}

model SaleTransaction {
  id                 String             @id @default(cuid())
  partyId            String
  raidId             String
  lootDropId         String
  quantitySold       Int
  totalPrice         BigInt
  receivedAt         DateTime
  comment            String?
  idempotencyKey     String
  distributionMethod DistributionMethod @default(WEIGHTED)
  algorithmVersion   Int                @default(1)
  createdAt          DateTime           @default(now())

  party             Party              @relation(fields: [partyId], references: [id], onDelete: Restrict)
  raid              Raid               @relation(fields: [partyId, raidId], references: [partyId, id], onDelete: Restrict)
  lootDrop          LootDrop           @relation(fields: [partyId, raidId, lootDropId], references: [partyId, raidId, id], onDelete: Restrict)
  shares            SaleShare[]
  ledgerTransaction LedgerTransaction?

  @@unique([partyId, id])
  @@unique([partyId, raidId, id])
  @@unique([partyId, idempotencyKey])
  @@index([partyId, lootDropId, receivedAt])
}

model SaleShare {
  id                 String             @id @default(cuid())
  partyId            String
  raidId             String
  saleTransactionId  String
  raidParticipantId  String
  memberId           String
  nicknameSnapshot   String
  weightSnapshot     Int
  distributionMethod DistributionMethod
  algorithmVersion   Int
  amount             BigInt
  createdAt          DateTime           @default(now())

  party              Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  saleTransaction    SaleTransaction     @relation(fields: [partyId, raidId, saleTransactionId], references: [partyId, raidId, id], onDelete: Restrict)
  raidParticipant    RaidParticipant     @relation(fields: [partyId, raidId, raidParticipantId, memberId], references: [partyId, raidId, id, memberId], onDelete: Restrict)
  member             PartyMember         @relation(fields: [partyId, memberId], references: [partyId, id], onDelete: Restrict)
  paymentAllocations PaymentAllocation[]

  @@unique([partyId, id])
  @@unique([partyId, memberId, id])
  @@unique([partyId, saleTransactionId, raidParticipantId])
  @@index([partyId, memberId, createdAt])
}

model MemberPayment {
  id               String   @id @default(cuid())
  partyId          String
  memberId         String
  nicknameSnapshot String
  amount           BigInt
  paidAt           DateTime
  comment          String?
  idempotencyKey   String
  createdAt        DateTime @default(now())

  party             Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  member            PartyMember         @relation(fields: [partyId, memberId], references: [partyId, id], onDelete: Restrict)
  allocations       PaymentAllocation[]
  ledgerTransaction LedgerTransaction?

  @@unique([partyId, id])
  @@unique([partyId, memberId, id])
  @@unique([partyId, idempotencyKey])
  @@index([partyId, memberId, paidAt])
}

model PaymentAllocation {
  id              String   @id @default(cuid())
  partyId         String
  memberId        String
  memberPaymentId String
  saleShareId     String
  amount          BigInt
  createdAt       DateTime @default(now())

  party         Party         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  memberPayment MemberPayment @relation(fields: [partyId, memberId, memberPaymentId], references: [partyId, memberId, id], onDelete: Restrict)
  saleShare     SaleShare     @relation(fields: [partyId, memberId, saleShareId], references: [partyId, memberId, id], onDelete: Restrict)

  @@unique([partyId, memberPaymentId, saleShareId])
  @@index([partyId, saleShareId])
}

model LedgerTransaction {
  id                String                  @id @default(cuid())
  partyId           String
  type              LedgerTransactionType
  status            LedgerTransactionStatus @default(DRAFT)
  saleTransactionId String?
  memberPaymentId   String?
  createdAt         DateTime                @default(now())
  postedAt          DateTime?

  party           Party            @relation(fields: [partyId], references: [id], onDelete: Restrict)
  saleTransaction SaleTransaction? @relation(fields: [partyId, saleTransactionId], references: [partyId, id], onDelete: Restrict)
  memberPayment   MemberPayment?   @relation(fields: [partyId, memberPaymentId], references: [partyId, id], onDelete: Restrict)
  entries         LedgerEntry[]

  @@unique([partyId, id])
  @@unique([partyId, saleTransactionId])
  @@unique([partyId, memberPaymentId])
}

model LedgerEntry {
  id                  String            @id @default(cuid())
  partyId             String
  ledgerTransactionId String
  accountType         LedgerAccountType
  partyMemberId       String?
  debit               BigInt            @default(0)
  credit              BigInt            @default(0)
  createdAt           DateTime          @default(now())

  party             Party             @relation(fields: [partyId], references: [id], onDelete: Restrict)
  ledgerTransaction LedgerTransaction @relation(fields: [partyId, ledgerTransactionId], references: [partyId, id], onDelete: Restrict)
  partyMember       PartyMember?      @relation(fields: [partyId, partyMemberId], references: [partyId, id], onDelete: Restrict)

  @@index([partyId, accountType, partyMemberId, createdAt])
}
