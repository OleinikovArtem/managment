generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum PartyRole {
  OWNER
  MANAGER
}

enum RaidParticipantStatus {
  PRESENT
  ABSENT
}

enum LootDropStatus {
  RECEIVED
}

model User {
  id          String             @id @default(cuid())
  email       String?            @unique
  displayName String
  createdAt   DateTime           @default(now())
  memberships PartyMembership[]
}

model Party {
  id          String             @id @default(cuid())
  name        String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships PartyMembership[]
  members     PartyMember[]
  items       Item[]
  raids       Raid[]
}

model PartyMembership {
  id        String    @id @default(cuid())
  partyId   String
  userId    String
  role      PartyRole @default(OWNER)
  createdAt DateTime  @default(now())

  party Party @relation(fields: [partyId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([partyId, userId])
  @@index([userId])
}

model PartyMember {
  id                 String   @id @default(cuid())
  partyId            String
  nickname           String
  normalizedNickname String
  isActive           Boolean  @default(true)
  comment            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Restrict)
  raidParticipants RaidParticipant[]

  @@unique([partyId, normalizedNickname])
  @@unique([partyId, id])
}

model Item {
  id             String   @id @default(cuid())
  partyId        String
  canonicalName  String
  normalizedName String
  displayName    String?
  category       String?
  gameVersion    String?
  comment        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Restrict)
  lootDrops LootDrop[]

  @@unique([partyId, normalizedName])
  @@unique([partyId, id])
  @@index([partyId, category])
}

model Raid {
  id             String   @id @default(cuid())
  partyId        String
  name           String
  instanceName   String?
  occurredAt     DateTime
  screenshotPath String?
  comment        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  party        Party             @relation(fields: [partyId], references: [id], onDelete: Restrict)
  participants RaidParticipant[]
  lootDrops    LootDrop[]

  @@unique([partyId, id])
  @@index([partyId, occurredAt])
}

model RaidParticipant {
  id               String                @id @default(cuid())
  partyId          String
  raidId           String
  memberId         String
  nicknameSnapshot String
  status           RaidParticipantStatus
  createdAt        DateTime              @default(now())

  raid   Raid        @relation(fields: [partyId, raidId], references: [partyId, id], onDelete: Restrict)
  member PartyMember @relation(fields: [partyId, memberId], references: [partyId, id], onDelete: Restrict)

  @@unique([partyId, raidId, memberId])
  @@index([partyId, memberId])
}

model LootDrop {
  id             String         @id @default(cuid())
  partyId        String
  raidId         String
  itemId         String
  quantity       Int
  screenshotPath String?
  status         LootDropStatus @default(RECEIVED)
  comment        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  raid Raid @relation(fields: [partyId, raidId], references: [partyId, id], onDelete: Restrict)
  item Item @relation(fields: [partyId, itemId], references: [partyId, id], onDelete: Restrict)

  @@unique([partyId, id])
  @@index([partyId, raidId, createdAt])
  @@index([partyId, itemId, createdAt])
}
